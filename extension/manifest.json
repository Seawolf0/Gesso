{
  "manifest_version": 3,
  "name": "Gesso",
  "short_name": "Gesso",
  "version": "0.11.0",
  "description": "An unofficial dashboard for Canvas: a faster, dark-first view of your courses. Runs entirely on your Mac. Not affiliated with Instructure.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },

  "permissions": ["storage", "unlimitedStorage", "alarms"],

  "host_permissions": ["https://umd.instructure.com/*"],

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "action": {
    "default_title": "Gesso",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://umd.instructure.com/*"],
      "run_at": "document_start",
      "all_frames": false,
      "css": ["src/content/native/dark.css"],
      "js": [
        "src/shared/namespace.js",
        "src/shared/config.js",
        "src/shared/settings.js",
        "src/shared/time.js",
        "src/shared/color.js",

        "src/content/api/client.js",
        "src/content/api/canvas.js",

        "src/content/data/normalize.js",
        "src/content/data/redact.js",
        "src/content/data/cache.js",
        "src/content/data/store.js",
        "src/content/data/planner.js",
        "src/content/data/derive.js",
        "src/content/data/query.js",
        "src/content/data/search.js",
        "src/content/data/calendar.js",
        "src/content/data/grades.js",
        "src/content/data/changes.js",
        "src/content/data/sync.js",
        "src/content/data/resources.js",
        "src/content/data/prefs.js",
        "src/content/data/grade-sources.js",
        "src/content/data/summary.js",
        "src/content/data/submit.js",
        "src/content/data/upload.js",

        "src/content/ui/dom.js",
        "src/content/ui/icons.js",
        "src/content/ui/styles/tokens.js",
        "src/content/ui/styles/base.js",
        "src/content/ui/styles/shell.js",
        "src/content/ui/styles/dashboard.js",
        "src/content/ui/styles/views.js",
        "src/content/ui/styles/detail.js",
        "src/content/ui/styles/calendar.js",
        "src/content/ui/styles/grades.js",
        "src/content/ui/sanitize.js",
        "src/content/ui/router.js",
        "src/content/ui/deeplink.js",
        "src/content/ui/components.js",
        "src/content/ui/charts.js",
        "src/content/ui/overlays.js",
        "src/content/ui/planner-ui.js",
        "src/content/ui/submit-dialog.js",
        "src/content/ui/palette.js",
        "src/content/ui/shortcuts.js",
        "src/content/ui/assignment-table.js",
        "src/content/ui/course-settings.js",
        "src/content/ui/views/placeholder.js",
        "src/content/ui/views/dashboard.js",
        "src/content/ui/views/assignments.js",
        "src/content/ui/views/courses.js",
        "src/content/ui/views/course-modules.js",
        "src/content/ui/views/course-files.js",
        "src/content/ui/views/course-announcements.js",
        "src/content/ui/views/assignment-detail.js",
        "src/content/ui/views/discussion-detail.js",
        "src/content/ui/views/peer-review-detail.js",
        "src/content/ui/views/debug.js",
        "src/content/ui/views/calendar.js",
        "src/content/ui/views/grades.js",
        "src/content/ui/views/course-grades.js",
        "src/content/ui/views/settings.js",
        "src/content/ui/views/course.js",
        "src/content/ui/shell.js",
        "src/content/ui/app.js",

        "src/content/native/dark-mode.js",
        "src/content/native/launcher.js",
        "src/content/health.js",
        "src/content/takeover.js",
        "src/content/main.js"
      ]
    }
  ]
}
